<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ChudikChat.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!--
			Воркло́д приносит 10.0.20, а CommunityToolkit.Maui 15 требует не ниже 10.0.90.
			Версию пакетов MAUI можно поднимать независимо от воркло́да — это штатный
			способ получать сервисные обновления.
		-->
		<MauiVersion>10.0.101</MauiVersion>

		<ApplicationTitle>Чудик</ApplicationTitle>
		<ApplicationId>com.chudik.chat</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!--
			Неупакованная сборка под Windows. Это не только про удобство установки:
			внутри MSIX AppContainer два экземпляра приложения не видят друг друга
			ни по loopback, ни по адресу локальной сети, а два экземпляра на одной
			машине — основной стенд для отладки. Для упакованной сборки понадобится
			capability privateNetworkClientServer в Package.appxmanifest.
		-->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- Android 8: ниже нет каналов уведомлений, без которых служба переднего плана не живёт. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!--
		Упаковка под Android.

		Оба свойства стоят здесь, а не флагами -p: в командной строке, и это не
		стилистика: -p: задаёт ГЛОБАЛЬНОЕ свойство, оно применяется ко всем целевым
		платформам и ко всем проектам. RuntimeIdentifiers=android-arm64 добрался бы
		до ChudikChat.Core с целью net10.0 и сломал восстановление — ровно та
		ловушка, что описана в build/publish-windows.ps1.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!--
			Только arm64. Умолчание SDK — android-arm64;android-x64, но x86_64 нужен
			единственно эмулятору, а в эмуляторе Чудик всё равно никого не находит:
			многоадресная рассылка туда не доходит. Половина размера пакета впустую.
		-->
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>

		<!--
			Множественное число обязательно. В конфигурации Release умолчание —
			AndroidPackageFormats=aab;apk, и из него AndroidPackageFormat становится
			aab раньше, чем сработало бы присваивание в единственном числе. Bundle
			нужен Google Play, а Чудик ставится файлом: это чистая трата времени сборки.
		-->
		<AndroidPackageFormats>apk</AndroidPackageFormats>
	</PropertyGroup>

	<!--
		Упаковка под Mac Catalyst. Здесь, а не флагом -p:, по той же причине,
		что и у Android: RuntimeIdentifier из командной строки — глобальное
		свойство, и оно добралось бы до ChudikChat.Core.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<!--
			Только Apple Silicon. Умолчание Release — универсальная сборка
			maccatalyst-x64;maccatalyst-arm64, то есть вдвое больше ради машин
			на Intel, которых у нас нет. Заодно это приводит сборку в согласие
			с UIRequiredDeviceCapabilities в Platforms/MacCatalyst/Info.plist,
			где arm64 уже указан обязательным.
		-->
		<RuntimeIdentifier>maccatalyst-arm64</RuntimeIdentifier>

		<!--
			.app, а не .pkg. Для десктопных целей умолчание — CreatePackage=true,
			то есть установщик, но без сертификата Installer он всё равно
			неподписанный, а Gatekeeper блокирует его ровно так же. Нам нужен
			бандл, который уедет в .dmg.
		-->
		<CreatePackage>false</CreatePackage>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F6FEB" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2F6FEB" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ChudikChat.Core\ChudikChat.Core.csproj" />
	</ItemGroup>

</Project>
