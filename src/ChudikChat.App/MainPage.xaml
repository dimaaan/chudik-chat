<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChudikChat.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:conv="clr-namespace:ChudikChat.App.Converters"
    xmlns:vm="clr-namespace:ChudikChat.App.ViewModels"
    x:DataType="vm:MainViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="Accent">#2F6FEB</Color>
        <toolkit:InvertedBoolConverter x:Key="Not" />
        <conv:MessageTextConverter x:Key="MessageText" />

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#2F6FEB, Dark=#8AB4FF}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>
    </ContentPage.Resources>

    <!--
        Нижняя кромка помечена All, и это единственное значение, при котором MAUI
        поднимает содержимое над экранной клавиатурой: отступ считается по ней,
        когда она есть, и по системной панели, когда её нет. Умолчание (Container)
        про клавиатуру не знает, а SoftInput потерял бы отступ под навигационной
        панелью. Остальные кромки оставлены Default — ведут себя как прежде.
        Работает в паре с WindowSoftInputModeAdjust.Resize в App.
    -->
    <Grid
        RowDefinitions="Auto,*"
        SafeAreaEdges="Default, Default, Default, All"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1D21}">

        <!--  Шапка  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,Auto,*,Auto,Auto"
            Padding="12,10"
            ColumnSpacing="6"
            BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#23262B}">

            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Style="{StaticResource ToolButton}"
                Text="‹ Список"
                IsVisible="False"
                Command="{Binding GoBackCommand}" />

            <!--
                Своя картинка, если операционная система её отдала. Буквы здесь нет
                намеренно: имя написано рядом целиком, и кружок с той же буквой — лишнее.
                Скрытый элемент схлопывает колонку Auto в ноль, поэтому там, где картинки
                не бывает, шапка выглядит как раньше.
            -->
            <Image
                Grid.Column="1"
                HeightRequest="32"
                WidthRequest="32"
                Margin="0,0,8,0"
                VerticalOptions="Center"
                Aspect="AspectFill"
                Source="{Binding MyAvatar}"
                IsVisible="{Binding HasMyAvatar}">
                <Image.Clip>
                    <EllipseGeometry
                        Center="16,16"
                        RadiusX="16"
                        RadiusY="16" />
                </Image.Clip>
            </Image>

            <VerticalStackLayout Grid.Column="2" Spacing="1">
                <Label
                    FontSize="15"
                    FontAttributes="Bold"
                    Text="{Binding MyName}"
                    TextColor="{AppThemeBinding Light=#1B1D21, Dark=#F2F4F7}" />
                <Label
                    FontSize="11"
                    Text="{Binding Status}"
                    LineBreakMode="TailTruncation"
                    TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA1AC}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="3"
                Style="{StaticResource ToolButton}"
                Text="Имя"
                Command="{Binding RenameCommand}" />

            <Button
                Grid.Column="4"
                Style="{StaticResource ToolButton}"
                Text="Обновить"
                Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PeersColumn" Width="300" />
                <ColumnDefinition x:Name="ChatColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Кто в сети  -->
            <Grid
                x:Name="PeersPane"
                Grid.Column="0"
                RowDefinitions="*,Auto"
                BackgroundColor="{AppThemeBinding Light=#FAFBFD, Dark=#1F2126}">

                <CollectionView
                    Grid.Row="0"
                    ItemsSource="{Binding Peers}"
                    SelectedItem="{Binding SelectedPeer, Mode=TwoWay}"
                    SelectionMode="Single">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24" Spacing="6" VerticalOptions="Center">
                            <Label
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                Text="Пока никого нет в сети"
                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA1AC}" />
                            <Label
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Text="Откройте «Чудик» на другом устройстве в той же сети"
                                TextColor="{AppThemeBinding Light=#9AA1AC, Dark=#6B7280}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PeerViewModel">
                            <!--
                                Отступы заданы полями содержимого, а не ColumnSpacing:
                                промежуток между колонками MAUI добавляет независимо от их
                                ширины, и у собеседника без известной платформы схлопнутая
                                в ноль колонка всё равно съедала бы лишние десять точек.
                                Поле принадлежит элементу и исчезает вместе с ним.
                            -->
                            <Grid Padding="12,10" ColumnDefinitions="36,Auto,*,Auto">
                                <Grid Grid.Column="0" HeightRequest="36" WidthRequest="36">

                                    <!--
                                        Подложка: она же кружок с буквой, когда картинки нет,
                                        она же фон под картинкой с прозрачностью, когда есть.
                                    -->
                                    <Border
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource Accent}"
                                        StrokeShape="RoundRectangle 18">
                                        <Label
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Text="{Binding Initials}"
                                            TextColor="White"
                                            IsVisible="{Binding HasAvatar, Converter={StaticResource Not}}" />
                                    </Border>

                                    <!--
                                        Обрезка задана на самой картинке, а не доверена Border:
                                        содержимое Border обрезают не все обработчики одинаково,
                                        а VisualElement.Clip применяют все три. Размер
                                        фиксированный, поэтому геометрия записана числами
                                        и пересчёта не требует.
                                    -->
                                    <Image
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        Aspect="AspectFill"
                                        Source="{Binding Avatar}"
                                        IsVisible="{Binding HasAvatar}">
                                        <Image.Clip>
                                            <EllipseGeometry
                                                Center="18,18"
                                                RadiusX="18"
                                                RadiusY="18" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>

                                <!--
                                    Операционная система собеседника: три фигуры внахлёст
                                    в одной клетке, видна ровно одна. Контейнера вокруг них
                                    нет намеренно — его ширина не дала бы колонке Auto
                                    схлопнуться там, где платформа неизвестна: у старой
                                    сборки, у Linux, у всего, чего мы ещё не знаем.

                                    Aspect="None", и координаты записаны сразу в тех
                                    шестнадцати точках, в которых фигура и рисуется.
                                    Uniform ужал бы каждую фигуру по её собственной рамке,
                                    и квадраты Windows, заполняющие рамку целиком, вышли бы
                                    заметно тяжелее узкого яблока. Здесь же размеры подобраны
                                    на глаз и одинаковы по весу.

                                    Дырки — правилом ненулевой обмотки (F1): глаза робота
                                    обходятся в обратную сторону и потому вычитаются.
                                -->
                                <Path
                                    Grid.Column="1"
                                    HeightRequest="16"
                                    WidthRequest="16"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center"
                                    Aspect="None"
                                    IsVisible="{Binding IsWindows}"
                                    Fill="{AppThemeBinding Light=#0078D4, Dark=#4CC2FF}"
                                    Data="F1 M1.5,1.5 H7.6 V7.6 H1.5 Z M8.4,1.5 H14.5 V7.6 H8.4 Z M1.5,8.4 H7.6 V14.5 H1.5 Z M8.4,8.4 H14.5 V14.5 H8.4 Z" />

                                <Path
                                    Grid.Column="1"
                                    HeightRequest="16"
                                    WidthRequest="16"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center"
                                    Aspect="None"
                                    IsVisible="{Binding IsMacOs}"
                                    Fill="{AppThemeBinding Light=#1B1D21, Dark=#F2F4F7}"
                                    Data="F1 M8.13,4.8 C7.47,4.13 6.73,3.8 5.8,3.8 C3.6,3.8 1.8,5.67 1.8,8.4 C1.8,11.27 3.8,15 5.8,15 C6.67,15 7.07,14.4 8.07,14.4 C9.07,14.4 9.4,15 10.33,15 C12.33,15 14.2,11.67 14.2,9.6 A1.867,1.867 0 0 1 14.2,6 C14,4.67 12.4,3.8 10.33,3.8 C9.4,3.8 8.73,4.13 8.13,4.8 Z M8.47,4.53 C10.33,4.27 11.47,2.67 11.27,1 C9.67,1.27 8.47,2.8 8.47,4.53 Z" />

                                <Path
                                    Grid.Column="1"
                                    HeightRequest="16"
                                    WidthRequest="16"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center"
                                    Aspect="None"
                                    IsVisible="{Binding IsAndroid}"
                                    Fill="#3DDC84"
                                    Data="F1 M0.75,13.3 A7.25,7.25 0 0 1 15.25,13.3 Z M2.49,3.35 L3.58,2.7 L6.12,7.05 L5.03,7.7 Z M13.51,3.35 L10.97,7.7 L9.89,7.05 L12.42,2.7 Z M4.01,8.94 A1.09,1.09 0 1 0 6.19,8.94 A1.09,1.09 0 1 0 4.01,8.94 Z M9.81,8.94 A1.09,1.09 0 1 0 11.99,8.94 A1.09,1.09 0 1 0 9.81,8.94 Z" />

                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    Spacing="1"
                                    VerticalOptions="Center">
                                    <Label
                                        FontSize="14"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding DisplayName}"
                                        TextColor="{AppThemeBinding Light=#1B1D21, Dark=#F2F4F7}" />
                                    <Label
                                        FontSize="11"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Address}"
                                        TextColor="{AppThemeBinding Light=#9AA1AC, Dark=#6B7280}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="3"
                                    Margin="10,0,0,0"
                                    Padding="7,2"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasUnread}"
                                    BackgroundColor="{StaticResource Accent}"
                                    StrokeShape="RoundRectangle 10">
                                    <Label
                                        FontSize="11"
                                        Text="{Binding UnreadCount}"
                                        TextColor="White" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    Grid.Row="1"
                    Margin="8"
                    Style="{StaticResource ToolButton}"
                    Text="Подключиться по адресу"
                    Command="{Binding AddByAddressCommand}" />
            </Grid>

            <!--  Переписка  -->
            <Grid x:Name="ChatPane" Grid.Column="1" RowDefinitions="*,Auto,Auto">

                <Label
                    Grid.Row="0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Text="Выберите собеседника"
                    IsVisible="{Binding HasSelection, Converter={StaticResource Not}}"
                    TextColor="{AppThemeBinding Light=#9AA1AC, Dark=#6B7280}" />

                <CollectionView
                    x:Name="MessagesView"
                    Grid.Row="0"
                    Margin="0,4"
                    ItemsSource="{Binding SelectedPeer.Messages}"
                    IsVisible="{Binding HasSelection}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageViewModel">
                            <Grid Padding="12,3">
                                <Border
                                    Padding="12,8"
                                    MaximumWidthRequest="520"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light=#EEF1F6, Dark=#2A2E35}">

                                    <!--
                                        Правый клик на Windows и macOS. На Android эта разметка
                                        просто ничего не делает: MenuFlyoutHandler там не
                                        зарегистрирован, а MapContextFlyout — пустой метод.
                                        Поэтому ветка под платформу ей не нужна, нужен другой
                                        жест — он ниже.
                                    -->
                                    <FlyoutBase.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="Копировать"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=CopyTextCommand}"
                                                CommandParameter="{Binding .}" />
                                        </MenuFlyout>
                                    </FlyoutBase.ContextFlyout>

                                    <Border.Behaviors>
                                        <!--
                                            Долгое нажатие вместо правого клика на Android.

                                            На настольных системах выключено. На Windows это
                                            поведение помечает PointerPressed обработанным
                                            и захватывает указатель для любой кнопки — то есть
                                            способно съесть правый клик вместе с меню выше.
                                            На macOS удержание левой кнопки копировало бы там,
                                            где принят правый клик.

                                            ShouldMakeChildrenInputTransparent обязателен:
                                            по умолчанию True, и тогда поведение проставляет
                                            InputTransparent детям Border — обеим подписям, —
                                            после чего ссылки в тексте перестают нажиматься.

                                            DisallowTouchThreshold намеренно не трогаем. Ноль
                                            означает, что список свободно перехватывает движение
                                            и прокручивается, а начатое долгое нажатие
                                            отменяется само.
                                        -->
                                        <toolkit:TouchBehavior
                                            IsEnabled="{OnPlatform Default=False, Android=True}"
                                            ShouldMakeChildrenInputTransparent="False"
                                            LongPressCompleted="OnMessageLongPressed" />
                                    </Border.Behaviors>

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsMine}"
                                            Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <VerticalStackLayout Spacing="2">
                                        <!--  Размеченный текст, а не Text: ссылки внутри нажимаются.  -->
                                        <Label
                                            FontSize="14"
                                            FormattedText="{Binding Text, Converter={StaticResource MessageText}}"
                                            TextColor="{AppThemeBinding Light=#1B1D21, Dark=#F2F4F7}">

                                            <Label.Behaviors>
                                                <!--
                                                    Второе такое же поведение, теперь на самой
                                                    подписи. У сообщения со ссылкой появляются
                                                    распознаватели жестов, и её нативный вид
                                                    забирает касание себе — до Border оно уже
                                                    не доходит. Без этой копии долгое нажатие
                                                    работало бы на тексте сообщений без ссылок
                                                    и не работало на тексте сообщений с ними.

                                                    За одно касание срабатывает то поведение,
                                                    чей вид касание забрал. Даже сработай оба,
                                                    в буфер лёг бы тот же самый текст.
                                                -->
                                                <toolkit:TouchBehavior
                                                    IsEnabled="{OnPlatform Default=False, Android=True}"
                                                    LongPressCompleted="OnMessageLongPressed" />
                                            </Label.Behaviors>

                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsMine}"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label
                                            FontSize="10"
                                            HorizontalOptions="End"
                                            TextColor="{AppThemeBinding Light=#9AA1AC, Dark=#7C838E}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="TimeText" />
                                                    <Binding Path="StateText" />
                                                </MultiBinding>
                                            </Label.Text>
                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsMine}"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="#D6E2FF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--  Передачи  -->
                <CollectionView
                    Grid.Row="1"
                    Margin="12,0"
                    MaximumHeightRequest="180"
                    ItemsSource="{Binding SelectedPeer.Transfers}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TransferViewModel">
                            <Border
                                Margin="0,3"
                                Padding="10,8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#F1F4F9, Dark=#272B31}">

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label
                                            FontSize="13"
                                            LineBreakMode="MiddleTruncation"
                                            Text="{Binding Title}"
                                            TextColor="{AppThemeBinding Light=#1B1D21, Dark=#F2F4F7}" />
                                        <ProgressBar
                                            Progress="{Binding Fraction}"
                                            ProgressColor="{StaticResource Accent}"
                                            IsVisible="{Binding IsFinished, Converter={StaticResource Not}}" />
                                        <Label
                                            FontSize="11"
                                            Text="{Binding StateText}"
                                            TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA1AC}" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource ToolButton}"
                                        Text="Открыть"
                                        IsVisible="{Binding CanOpenFolder}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenFolderCommand}"
                                        CommandParameter="{Binding .}" />

                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource ToolButton}"
                                        Text="Отмена"
                                        IsVisible="{Binding CanCancel}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=CancelTransferCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--  Ввод  -->
                <Grid
                    Grid.Row="2"
                    Padding="12,8"
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="6"
                    IsVisible="{Binding HasSelection}"
                    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#23262B}">

                    <Button
                        Grid.Column="0"
                        Style="{StaticResource ToolButton}"
                        Text="Файл"
                        Command="{Binding PickFilesCommand}" />

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource ToolButton}"
                        Text="Папка"
                        IsVisible="{Binding CanSendFolders}"
                        Command="{Binding PickFolderCommand}" />

                    <Entry
                        Grid.Column="2"
                        Placeholder="Сообщение"
                        Text="{Binding Draft, Mode=TwoWay}"
                        ReturnCommand="{Binding SendCommand}" />

                    <Button
                        Grid.Column="3"
                        Padding="16,6"
                        Text="Отправить"
                        TextColor="White"
                        BackgroundColor="{StaticResource Accent}"
                        Command="{Binding SendCommand}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
